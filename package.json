{
    "name": "@voml/von-workspace",
    "private": true,
    "description": "Virtual Object Notation (VON) language workspace",
    "homepage": "https://von-language.pages.dev/",
    "packageManager": "pnpm@10.0.0",
    "type": "module",
    "scripts": {
        "fmt": "node scripts/format.mjs",
        "fmt:check": "node scripts/format.mjs --check",
        "dev": "pnpm --filter @voml/von-homepage dev",
        "homepage": "pnpm --filter @voml/von-homepage build:cdn && node scripts/sync-homepage-dist.mjs",
        "build": "pnpm -r --filter @voml/von --filter @voml/von-language --filter @voml/von-schema run build",
        "test": "pnpm build && pnpm -r --filter @voml/von --filter @voml/von-language --filter @voml/von-schema run test",
        "typecheck": "pnpm -r --filter @voml/von --filter @voml/von-language --filter @voml/von-schema --filter @voml/von-skills --filter @voml/von-homepage run typecheck",
        "test:rs": "cargo test --workspace --all-features",
        "check:rs": "cargo check --workspace --all-features",
        "placeholder": "nifty publish --placeholder --dry-run",
        "placeholder:publish": "nifty publish --placeholder",
        "placeholder:trust": "nifty trust"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.8",
        "@doki-land/nifty": "^0.0.12"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}
