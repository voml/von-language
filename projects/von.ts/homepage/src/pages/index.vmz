<template>
  <div class="home">
    <section class="home__hero">
      <div>
        <p class="home__eyebrow">{homeEyebrowLabel}</p>
        <h1 class="home__brand">{brandShortLabel}</h1>
        <p class="home__full-name">{brandFullLabel}</p>
        <p class="home__lede">{homeLedeLabel}</p>
        <div class="home__actions">
          <Button type="button" onClick={() => this.goPlayground()}>{homeOpenPlaygroundLabel}</Button>
          <Button type="button" variant="secondary" onClick={() => this.goPackages()}>{homeViewPackagesLabel}</Button>
        </div>
      </div>

      <div class="home__visual" aria-hidden="true">
        <div class="home__orbit"></div>
        <div class="home__shard home__shard-a"></div>
        <div class="home__shard home__shard-b"></div>
        <div class="home__code-wrap">
          <CodeBlock code={sampleVon} caption="VON" copyLabel="Copy" />
        </div>
      </div>
    </section>

    <section class="home__section">
      <div class="home__section-head">
        <h2>{homeWhyTitleLabel}</h2>
        <p>{homeWhyLedeLabel}</p>
      </div>
      <div class="home__feature-grid">
        <article>
          <Badge tone="brand">{homeFeaturesCommentsTitleLabel}</Badge>
          <h3>{homeFeaturesCommentsTitleLabel}</h3>
          <p>{homeFeaturesCommentsBodyLabel}</p>
        </article>
        <article>
          <Badge tone="info">{homeFeaturesBareTitleLabel}</Badge>
          <h3>{homeFeaturesBareTitleLabel}</h3>
          <p>{homeFeaturesBareBodyLabel}</p>
        </article>
        <article>
          <Badge tone="warning">{homeFeaturesFloatsTitleLabel}</Badge>
          <h3>{homeFeaturesFloatsTitleLabel}</h3>
          <p>{homeFeaturesFloatsBodyLabel}</p>
        </article>
        <article>
          <Badge tone="success">{homeFeaturesSchemaTitleLabel}</Badge>
          <h3>{homeFeaturesSchemaTitleLabel}</h3>
          <p>{homeFeaturesSchemaBodyLabel}</p>
        </article>
      </div>
    </section>

    <section id="packages" class="home__section">
      <div class="home__section-head">
        <h2>{homePackagesTitleLabel}</h2>
        <p>{homePackagesLedeLabel}</p>
      </div>
      <div class="home__pkg-grid">
        <article>
          <code>@game-gpt/von</code>
          <p>{homePkgVonLabel}</p>
        </article>
        <article>
          <code>@game-gpt/von-schema</code>
          <p>{homePkgSchemaLabel}</p>
        </article>
      </div>
      <div class="home__actions" style="margin-top: 1.5rem">
        <Button type="button" onClick={() => this.goPlayground()}>{homeTryPlaygroundLabel}</Button>
      </div>
    </section>
  </div>
</template>

<script client>
import {
  brandShort,
  brandFull,
  homeEyebrow,
  homeLede,
  homeOpenPlayground,
  homeViewPackages,
  homeWhyTitle,
  homeWhyLede,
  homeFeaturesCommentsTitle,
  homeFeaturesCommentsBody,
  homeFeaturesBareTitle,
  homeFeaturesBareBody,
  homeFeaturesFloatsTitle,
  homeFeaturesFloatsBody,
  homeFeaturesSchemaTitle,
  homeFeaturesSchemaBody,
  homePackagesTitle,
  homePackagesLede,
  homePkgVon,
  homePkgSchema,
  homeTryPlayground,
} from "#locales/common";
import { SAMPLE_VON } from "../lib/samples.ts";
import { readLocaleId, withLocaleHint, watchDocumentLocale } from "../lib/locale-copy.ts";

export default class IndexPage {
  localeId = "en-us";
  sampleVon = SAMPLE_VON;
  brandShortLabel = "";
  brandFullLabel = "";
  homeEyebrowLabel = "";
  homeLedeLabel = "";
  homeOpenPlaygroundLabel = "";
  homeViewPackagesLabel = "";
  homeWhyTitleLabel = "";
  homeWhyLedeLabel = "";
  homeFeaturesCommentsTitleLabel = "";
  homeFeaturesCommentsBodyLabel = "";
  homeFeaturesBareTitleLabel = "";
  homeFeaturesBareBodyLabel = "";
  homeFeaturesFloatsTitleLabel = "";
  homeFeaturesFloatsBodyLabel = "";
  homeFeaturesSchemaTitleLabel = "";
  homeFeaturesSchemaBodyLabel = "";
  homePackagesTitleLabel = "";
  homePackagesLedeLabel = "";
  homePkgVonLabel = "";
  homePkgSchemaLabel = "";
  homeTryPlaygroundLabel = "";
  _unwatchLocale = null;

  onMount() {
    this.applyLocaleCopy();
    this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
  }

  onDestroy() {
    if (typeof this._unwatchLocale === "function") this._unwatchLocale();
    this._unwatchLocale = null;
  }

  refreshCopy() {
    this.brandShortLabel = brandShort();
    this.brandFullLabel = brandFull();
    this.homeEyebrowLabel = homeEyebrow();
    this.homeLedeLabel = homeLede();
    this.homeOpenPlaygroundLabel = homeOpenPlayground();
    this.homeViewPackagesLabel = homeViewPackages();
    this.homeWhyTitleLabel = homeWhyTitle();
    this.homeWhyLedeLabel = homeWhyLede();
    this.homeFeaturesCommentsTitleLabel = homeFeaturesCommentsTitle();
    this.homeFeaturesCommentsBodyLabel = homeFeaturesCommentsBody();
    this.homeFeaturesBareTitleLabel = homeFeaturesBareTitle();
    this.homeFeaturesBareBodyLabel = homeFeaturesBareBody();
    this.homeFeaturesFloatsTitleLabel = homeFeaturesFloatsTitle();
    this.homeFeaturesFloatsBodyLabel = homeFeaturesFloatsBody();
    this.homeFeaturesSchemaTitleLabel = homeFeaturesSchemaTitle();
    this.homeFeaturesSchemaBodyLabel = homeFeaturesSchemaBody();
    this.homePackagesTitleLabel = homePackagesTitle();
    this.homePackagesLedeLabel = homePackagesLede();
    this.homePkgVonLabel = homePkgVon();
    this.homePkgSchemaLabel = homePkgSchema();
    this.homeTryPlaygroundLabel = homeTryPlayground();
  }

  applyLocaleCopy(preferred) {
    this.localeId = readLocaleId(preferred);
    withLocaleHint(this.localeId, () => this.refreshCopy());
  }

  goPlayground() {
    if (typeof window !== "undefined") window.location.href = "/playground";
  }

  goPackages() {
    if (typeof window !== "undefined") window.location.hash = "packages";
  }
}
</script>
